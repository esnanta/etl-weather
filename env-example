# App environment.
# dev: development mode (guarded DB recreation may be available)
# prod: production mode (DB recreation is disabled)
# APP_ENV is required; invalid or empty values stop startup.
APP_ENV=dev

# CDS API connection.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=YOUR_UID:YOUR_API_KEY

# Primary PostgreSQL database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Separate PostgreSQL database for integration tests only.
# TEST_POSTGRES_DATABASE must include the word "test".
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DATABASE=weather_test
TEST_POSTGRES_USER=your_test_username
TEST_POSTGRES_PASSWORD=your_test_password

# Default inclusive date range for standalone runs.
# Used only when no explicit period is provided.
# Format: YYYY-MM-DD
CDS_START_DATE=2022-01-01
CDS_END_DATE=2022-01-03

# Airflow historical campaign settings.
# CAMPAIGN_KEY: stable identifier for campaign progress and reporting.
# CAMPAIGN_START_YEAR / CAMPAIGN_END_YEAR:
# - Must be 4-digit years.
# - Scheduler uses Jan 1 of start year to Dec 31 of end year.
# - For short pilots, prefer manual runs with explicit start_date/end_date.
CAMPAIGN_KEY=era5_land_2016_2025
CAMPAIGN_START_YEAR=2016
CAMPAIGN_END_YEAR=2016

# ERA5_CAMPAIGN_SCHEDULE_ENABLED=false: manual DAG runs only (no auto schedule).
# ERA5_CAMPAIGN_SCHEDULE_ENABLED=true: run scheduled bounded historical campaigns.
ERA5_CAMPAIGN_SCHEDULE_ENABLED=true

# Airflow schedule cadence (used only when scheduling is enabled).
# Allowed values: 30m, 1h, 2h.
ERA5_CAMPAIGN_SCHEDULE_CADENCE=2h

# Minimum interval between provider submission POST requests (seconds).
# Independent of scheduler cadence.
SUBMISSION_INTERVAL_SECONDS=300

# Shared Airflow JWT secret is managed outside .env.
# See orchestration/README.md for setup instructions.
