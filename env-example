# Application environment.
APP_ENV=dev

CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=YOUR_UID:YOUR_API_KEY

# Standalone pipeline default inclusive period (YYYY-MM-DD).
# Keep this small for local/ad-hoc runs.
CDS_START_DATE=2022-01-01
CDS_END_DATE=2022-01-03

# Airflow historical campaign identity and inclusive date bounds.
# The campaign scheduler processes exact calendar quarters, so the start must
# be the first day of a quarter and the end the last day of a quarter.
CAMPAIGN_KEY=era5_land_2016_2025
CAMPAIGN_START_DATE=2016-01-01
CAMPAIGN_END_DATE=2017-12-31

ERA5_CAMPAIGN_SCHEDULE_ENABLED=false
ERA5_CAMPAIGN_SCHEDULE_CADENCE=2h
SUBMISSION_INTERVAL_SECONDS=1800

# The shared Airflow JWT secret is stored outside .env.
# See orchestration/README.md for generation instructions.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Isolated PostgreSQL database used only by integration tests.
# TEST_POSTGRES_DATABASE must contain the word "test".
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DATABASE=weather_test
TEST_POSTGRES_USER=your_test_username
TEST_POSTGRES_PASSWORD=your_test_password
