# Application environment.
# dev  : development runtime; guarded database recreation may be available.
# prod : production runtime; database recreation is unavailable.
# APP_ENV is mandatory. Missing, blank, or unsupported values abort startup.
APP_ENV=dev

CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=YOUR_UID:YOUR_API_KEY

# Airflow historical campaign scheduling.
#
# false:
#   The DAG is manual-only (schedule=None). Airflow will not create scheduled
#   DagRuns automatically. Manual DagRuns can still be triggered explicitly.
#
# true:
#   Airflow enables the bounded historical campaign scheduler. Each scheduled
#   DagRun does not receive start_date/end_date from this file; instead it
#   selects the earliest eligible incomplete campaign quarter from durable
#   PostgreSQL progress state.
#
# Campaign identity and bounded historical range.
#
# CAMPAIGN_KEY:
#   Stable logical identity used by campaign progress selection and reporting.
#   Keep this value unchanged for the same logical historical campaign.
#
# CAMPAIGN_START_YEAR / CAMPAIGN_END_YEAR:
#   First and last calendar years included in the bounded campaign.
#   The current controlled rollout is limited to 2016 through 2017.
#
# These values are required. activate-airflow.sh validates and displays them
# at startup, and orchestration/config.py reads the same exported values for
# campaign selection and reporting.
CAMPAIGN_KEY=era5_land_2016_2025
CAMPAIGN_START_YEAR=2016
CAMPAIGN_END_YEAR=2017
#
# Change campaign or schedule settings only while Airflow standalone is
# stopped, then restart standalone so the DAG processor reparses the DAG.
ERA5_CAMPAIGN_SCHEDULE_ENABLED=false

# Airflow scheduler cadence used only when
# ERA5_CAMPAIGN_SCHEDULE_ENABLED=true.
#
# Supported values:
#   30m = scheduler tick every 30 minutes
#   1h  = scheduler tick every 1 hour
#   2h  = scheduler tick every 2 hours
#
# The cron expressions are evaluated in the DAG timezone (Asia/Jakarta).
# A scheduler tick means "Airflow may start/select campaign work"; it does NOT
# mean that one quarter must finish within the cadence interval.
#
# The DAG keeps max_active_runs=1, so a new scheduled run will not overlap an
# already active run. Quarter selection is also protected by durable progress
# claims in PostgreSQL.
ERA5_CAMPAIGN_SCHEDULE_CADENCE=2h

# Minimum interval between actual CDS submission POST requests, in seconds.
#
# This setting is independent from ERA5_CAMPAIGN_SCHEDULE_CADENCE.
# It controls provider submission pacing, not how often Airflow schedules a DAG.
#
# Default:
#   1800 seconds = 30 minutes
#
# The pacing gate is stored in climate_data.cds_submission_pacing and uses the
# PostgreSQL clock plus row locking so separate workers/runs cannot submit CDS
# requests too close together.
#
# A single monthly partition may require more than one CDS submission, for
# example a previous-day/month context request plus the target-month request.
# Each actual submission must pass this pacing gate.
#
# When a slot is not yet available, the extraction task defers and is resumed
# later by Airflow; the wait is not counted as a provider failure.
CDS_MIN_SUBMISSION_INTERVAL_SECONDS=1800

# The shared Airflow JWT secret is stored outside .env
# Further instructions for generating
# the secret are in the orchestration/README.md file.

# PostgreSQL database used by the pipeline.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Isolated PostgreSQL database used only by integration tests.
# TEST_POSTGRES_DATABASE must contain the word "test".
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DATABASE=weather_test
TEST_POSTGRES_USER=your_test_username
TEST_POSTGRES_PASSWORD=your_test_password
